# =============================================================================
# K12 Hunar — Environment Configuration Reference
# =============================================================================
# Copy this file to backend/.env and frontend/.env respectively, or configure
# these environment variables in your deployment dashboard (Render & Vercel).
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (backend/.env)
# -----------------------------------------------------------------------------
# HTTP Server Port
PORT=4000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Standard libpq connection URI)
# Find this in Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_SSL=true

# Custom JWT Authentication (Strictly independent of Supabase Auth)
# Generate a secure 64-byte random hex string for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-secure-64-char-random-hex-secret-in-production"
JWT_EXPIRES_IN="12h"
BCRYPT_SALT_ROUNDS=12

# Allowed CORS Origin(s) - Comma-separated if multiple (e.g. localhost, Vercel app)
CORS_ORIGIN="http://localhost:5173"

# Admin Provisioning Credentials (Used by `npm run provision:admin`)
INITIAL_ADMIN_EMAIL="admin@k12hunar.edu.in"
INITIAL_ADMIN_PASSWORD="HunarAdmin#2026"

# -----------------------------------------------------------------------------
# FRONTEND (frontend/.env)
# -----------------------------------------------------------------------------
# Base URL for Express Backend API (e.g., https://your-api.onrender.com/api in production)
VITE_API_BASE_URL="http://localhost:4000/api"
