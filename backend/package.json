{
  "name": "k12-hunar-backend",
  "version": "1.0.0",
  "description": "K12 Hunar EdTech CRM & Inquiry Management System - Express + TypeScript Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "provision:admin": "tsx src/scripts/provision-admin.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/backend.test.mjs"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x"
  }
}
